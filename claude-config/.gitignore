# ~/.claude config repo — FAIL-CLOSED allowlist.
#
# Claude Code keeps adding new top-level dirs over time (e.g. chrome/,
# downloads/, daemon/, session-env/ ...), some of which can hold sensitive
# data. A denylist would let any new one slip in via `git add -A`. So we ignore
# EVERYTHING, then re-include only the authored config we intend to track.
#
# Adding a NEW authored item later? Re-include it here with a `!/name` line.

/*

# --- authored config (tracked) ---
!/.gitignore
!/.stignore
!/.github/
!/hooks-git/
!/settings.json
!/settings.local.json
!/keybindings.json
!/CLAUDE.md
!/commands/
!/agents/
!/skills/
!/hooks/
!/rules/

# Never track, even if re-included by a broad rule above:
.DS_Store
