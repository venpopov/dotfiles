{
  "cleanupPeriodDays": 999999,
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check-structure.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
