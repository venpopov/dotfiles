brew "gh"
brew "neovim"
brew "fzf"
brew "bat"
brew "ripgrep"
brew "fd"
brew "jq"
brew "node"
brew "tree"

# R toolchain (via rig — not plain `brew "r"` which conflicts)
cask "r-lib/rig/rig"

# Publishing
cask "quarto"

# Dev apps
cask "1password"
